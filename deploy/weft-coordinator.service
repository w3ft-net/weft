[Unit]
Description=weft coordinator
After=network.target

[Service]
Type=simple
User=app
Group=app
EnvironmentFile=/opt/app/.env
ExecStart=/opt/app/bin/weft-coordinator \
    --port=9020 \
    --compute=${COMPUTE_NLB} \
    --region=${AWS_REGION} \
    --redis-addr=${REDIS_ADDR} \
    --redis-tls=${REDIS_TLS}
Restart=always
RestartSec=5
Environment=WEFT_LOG_FILE=/opt/app/logs/coordinator.log

[Install]
WantedBy=multi-user.target

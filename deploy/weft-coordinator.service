[Unit]
Description=weft coordinator
After=network.target

[Service]
Type=simple
User=app
Group=app
EnvironmentFile=/opt/app/.env
ExecStart=/opt/app/bin/weft-coordinator \
    --port=9020 \
    --health-port=9021 \
    --shard-asg-small=${SHARD_ASG_SMALL} \
    --shard-asg-medium=${SHARD_ASG_MEDIUM} \
    --shard-asg-large=${SHARD_ASG_LARGE} \
    --compute=${COMPUTE_NLB} \
    --compute-asg=${COMPUTE_ASG_NAME} \
    --region=${AWS_REGION}
Restart=always
RestartSec=5
StandardOutput=append:/opt/app/logs/coordinator.log
StandardError=append:/opt/app/logs/coordinator.log

[Install]
WantedBy=multi-user.target

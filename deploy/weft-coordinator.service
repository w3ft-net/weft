[Unit]
Description=weft coordinator
After=network.target

[Service]
Type=simple
User=app
Group=app
EnvironmentFile=/opt/app/coordinator.env
ExecStart=/opt/app/bin/weft-coordinator \
    --port=9020 \
    --health-port=9021 \
    --shard-asg-small=${WEFT_SHARD_ASG_SMALL} \
    --shard-asg-medium=${WEFT_SHARD_ASG_MEDIUM} \
    --shard-asg-large=${WEFT_SHARD_ASG_LARGE} \
    --compute-asg=${WEFT_COMPUTE_ASG} \
    --region=${WEFT_REGION} \
    --customer=kevlar
Restart=always
RestartSec=5
StandardOutput=append:/opt/app/logs/coordinator.log
StandardError=append:/opt/app/logs/coordinator.log

[Install]
WantedBy=multi-user.target

[Unit]
Description=Loom Inc synthetic log producer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/app/bin/loom-producer --config /etc/loom-producer/streams.yaml
Restart=always
RestartSec=5
# Avoid the producer pinning the host CPU if a config loop misfires.
CPUWeight=50

[Install]
WantedBy=multi-user.target

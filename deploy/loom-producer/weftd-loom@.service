[Unit]
Description=weftd-loom forwarder (env=%i)
# Started via weft-loom-producer.service's Wants= so it gets activated
# in the same `systemctl start weft-loom-producer` call. After= is
# ordering only - we still need network up before weftd dials home.
After=network.target
Wants=network.target
PartOf=weft-loom-producer.service

[Service]
Type=simple
User=root
# /opt/app/.env is populated by the AMI's weft-startup.service via
# load-app-env (which pulls every /weft/* secret through kevcons). It
# carries LOOM_PROD_TOKEN / LOOM_SAND_TOKEN; render-weftd-config.sh
# below picks the one matching this instance's %i and writes config.yaml.
EnvironmentFile=/opt/app/.env
ExecStartPre=/opt/app/scripts/loom-producer/render-weftd-config.sh %i
ExecStart=/usr/local/bin/weftd --config /etc/weftd-loom-%i/config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

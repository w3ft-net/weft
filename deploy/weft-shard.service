[Unit]
Description=weft shard
After=network.target

[Service]
Type=simple
User=app
Group=app
EnvironmentFile=/opt/app/.env
ExecStart=/opt/app/bin/weft-shard \
    --grpc-port=9000 \
    --http-port=9001 \
    --data-dir=/opt/app/data \
    --coordinator-addr=${COORDINATOR_NLB}
Restart=always
RestartSec=5
StandardOutput=append:/opt/app/logs/shard.log
StandardError=append:/opt/app/logs/shard.log

[Install]
WantedBy=multi-user.target

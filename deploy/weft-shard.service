[Unit]
Description=weft shard
After=network.target

[Service]
Type=simple
User=app
Group=app
EnvironmentFile=-/opt/app/shard.env
ExecStart=/opt/app/bin/weft-shard \
    --id=${SHARD_ID} \
    --grpc-port=9000 \
    --http-port=9001 \
    --db=/opt/app/data/shard.duckdb \
    --window-start=${WINDOW_START} \
    --window-end=${WINDOW_END} \
    --coordinator-addr=${COORDINATOR_ADDR}
Restart=always
RestartSec=5
StandardOutput=append:/opt/app/logs/shard.log
StandardError=append:/opt/app/logs/shard.log

[Install]
WantedBy=multi-user.target

# /etc/default/weftd — environment for the weftd log agent.
#
# /etc/weftd/config.yaml is regenerated from these variables on every
# weftd start (see /usr/lib/weftd/weftd-config.sh). Edit this file, then:
#     systemctl restart weftd
#
# Only WEFTD_TOKEN is required. Everything else has sensible defaults.
#
# NOTE: weftd-specific vars use the WEFTD_ prefix on purpose. Hosts
# that also run the weft coordinator use unprefixed names for admin
# config (DB_DSN, SHARD_ASG_SMALL, etc.) and those MUST stay out of
# weftd's env to avoid colliding with the same-named weft vars.

# Agent auth token issued by the weft coordinator (required).
#WEFTD_TOKEN=

# Coordinator ingest endpoint (host:port).
#WEFTD_ENDPOINT=ingest.w3ft.net:9020

# App name used to tag emitted log rows. Defaults to "unknown".
#WEFTD_APP=myapp

# systemd unit to tail. Defaults to ${WEFTD_APP}.service.
#WEFTD_UNIT=myapp.service

# File path or glob of log files to tail.
# Multiple globs can be specified space-separated.
#WEFTD_LOG_PATH=/var/log/myapp/*.log

# Logical host-group tag stamped on every emitted row. Use this to
# distinguish classes of hosts that share a token (e.g. "web", "worker",
# "edge-us-east"). Leaving this unset is fine for single-group installs.
#WEFTD_HOST_GROUP=

# Enable periodic system metrics collection (cpu / memory / disk / load / network).
#WEFTD_METRICS=false
#WEFTD_METRICS_INTERVAL=30s

# Unix socket for local line ingest (applications can write log lines to it).
#WEFTD_SOCKET=/var/run/weftd/weftd.sock

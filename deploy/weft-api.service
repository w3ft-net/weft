[Unit]
Description=weft API server
After=network.target weft-coordinator.service
Wants=weft-coordinator.service

[Service]
Type=simple
User=app
Group=app
EnvironmentFile=/opt/app/.env
ExecStart=/opt/app/bin/weft-api \
    --port=8080 \
    --coordinator=localhost:9025 \
    --base-url=https://w3ft.net
Restart=always
RestartSec=5
Environment=WEFT_LOG_FILE=/opt/app/logs/api.log

[Install]
WantedBy=multi-user.target

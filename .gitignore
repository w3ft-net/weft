# Compiled binaries — build artifacts, never committed. Real
# releases are built by the release process with ldflags, not from
# a checked-in blob.
/server
/weft
/wef
/weft-admin
weftd/weftd
*.exe

# Local config (contains endpoint/credentials)
.weft.yaml

# DuckDB databases
*.duckdb
*.duckdb.wal

# Generated schema files (from weft setup)
*.schema.yaml

# IDE
.idea/
.vscode/
# The built Lambda binary, not the cmd/lambda-shard source directory.
/lambda-shard
/cmd/lambda-shard/lambda-shard

# Stray process logs from shard-local dev runs
shard.log

# Per-container coverage output from coverage-instrumented
# integration runs (docker-compose.cover.yml). Regenerated on
# every run by the server binaries; never committed.
/coverage/
dev/demo/tokens.env
dev/demo/weft-demo-seed
dev/demo/__pycache__/
dev/demo/.pytest_cache/

# DockerLauncher dev shard volumes (DuckDB + parquet — multi-GB,
# regenerated on every up). Never committed.
dev/shard-data/

# Sub-agent worktree scratch directories created by `Agent` /
# isolation: "worktree". Local-only.
.claude/worktrees/

# Diagnostic dumps from EC2 console output investigations.
console.log
tail.log

# Packer post-processor manifests (regenerated by `kevcons build`).
manifest*.json

# Coverage HTML/text exports written by ad-hoc local runs (the CI path
# uses /coverage/ above). Stray bare /wasm and node_modules at the repo
# root are dev-only scratch — the real wasm artifact lives at
# frontend/public/shell.wasm, the real node_modules at frontend/.
coverage-baseline.html
coverage-baseline.out
/node_modules/
/wasm

# local worktree go.work (gitignored)
go.work
go.work.sum

# Production database dumps pulled for local verification: customer data.
/prod.sql
.env
.trello.json

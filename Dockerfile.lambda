# Build the Lambda cold shard binary.
# docker build -f weft/Dockerfile.lambda -t weft-lambda-shard ..

# Build on Amazon Linux 2023 — the same distro as the provided.al2023
# Lambda runtime — so the CGO_ENABLED=1 (duckdb) binary links against the
# runtime's glibc (AL2023 = glibc 2.34). The golang:* Debian images need
# GLIBC_2.38+, which AL2023 does not provide, so a Debian-built cgo binary
# fails to load at runtime. Pinned to linux/amd64 (Lambda is x86_64) so the
# build is independent of the CI runner arch.
FROM --platform=linux/amd64 amazonlinux:2023 AS builder

# Keep >= the `go` directive in go.mod. Bump as the toolchain moves.
ARG GO_VERSION=1.26.0
RUN dnf install -y gcc gcc-c++ tar gzip git findutils && \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
      | tar -C /usr/local -xz
ENV PATH=/usr/local/go/bin:$PATH

WORKDIR /src
COPY warp /src/warp
COPY saaskit /src/saaskit
COPY weft /src/weft
WORKDIR /src/weft

RUN go work init . ../warp ../saaskit
RUN go mod download
# duckdb is C++ and the minimal provided.al2023 runtime ships no
# libstdc++/libgcc, so static-link them; glibc stays dynamic and is
# satisfied by the AL2023 runtime.
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -ldflags '-linkmode external -extldflags "-static-libstdc++ -static-libgcc"' \
    -o /bin/bootstrap ./cmd/lambda-shard/

# Use AWS Lambda x86_64 base image (matches Terraform architectures).
FROM public.ecr.aws/lambda/provided:al2023-x86_64

COPY --from=builder /bin/bootstrap ${LAMBDA_RUNTIME_DIR}/bootstrap
CMD ["bootstrap"]

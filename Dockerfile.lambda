# Build the Lambda cold shard binary.
# docker build -f weft/Dockerfile.lambda -t weft-lambda-shard ..

FROM golang:1.26 AS builder

WORKDIR /src
COPY warp /src/warp
COPY weft /src/weft
WORKDIR /src/weft

RUN sed -i 's|=> ../warp|=> /src/warp|' go.mod
RUN go mod download
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /bin/bootstrap ./cmd/lambda-shard/

# Use AWS Lambda base image for RIE compatibility.
FROM public.ecr.aws/lambda/provided:al2023

COPY --from=builder /bin/bootstrap ${LAMBDA_RUNTIME_DIR}/bootstrap
CMD ["bootstrap"]

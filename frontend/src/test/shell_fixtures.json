        "name": "cat /tmp/notes.txt ships",
        "command": "cat /tmp/notes.txt",
        "want_dispatch": "cat /tmp/notes.txt"
      },
      {
        "name": "ls /tmp ships",
        "command": "ls /tmp",
        "want_dispatch": "ls /tmp"
      }
    ]
  },
  {
    "name": "cron.d operations",
    "files": [
      {
        "path": "/cron.d/heartbeat",

[
  {
    "name": "root listing",
    "files": [
      {
        "path": "/bin/hello",
        "content": "echo hi"
      },
      {
        "path": "/tmp/scratch",
        "content": "temp"
      }
    ],
    "cases": [
      {
        "name": "ls / ships",
        "command": "ls /",
        "want_dispatch": "ls /"
      }
    ]
  },
  {
    "name": "bin operations",
    "files": [
      {
        "path": "/bin/hello",
        "content": "echo hi"
      },
      {
        "path": "/bin/check",
        "content": "#!/usr/bin/env lua\nprint('ok')"
      }
    ],
    "cases": [
      {
        "name": "ls /bin ships",
        "command": "ls /bin",
        "want_dispatch": "ls /bin"
      },
      {
        "name": "cat /bin/hello ships",
        "command": "cat /bin/hello",
        "want_dispatch": "cat /bin/hello"
      },
      {
        "name": "cat nonexistent ships (server reports the error)",
        "command": "cat /bin/nope",
        "want_dispatch": "cat /bin/nope"
      }
    ]
  },
  {
    "name": "log queries",
    "files": [
      {
        "path": "/bin/hello",
        "content": "echo hi"
      }
    ],
    "cases": [
      {
        "name": "cat /log/\u003capp\u003e ships",
        "command": "cat /log/myapp.log",

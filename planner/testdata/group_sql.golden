== trace --spans acme/api
shard="SELECT json_object('name', span_name, 'namespace', namespace, 'service', service, 'bucket', bucket, 'count', count(*) FILTER (WHERE duration_ns > 0), 'errors', count(*) FILTER (WHERE level = 'ERROR'), 'levels', count(*) FILTER (WHERE level <> ''), 'total_ns', sum(duration_ns) FILTER (WHERE duration_ns > 0), 'min_ns', min(duration_ns) FILTER (WHERE duration_ns > 0), 'max_ns', max(duration_ns) FILTER (WHERE duration_ns > 0))::VARCHAR AS raw, min(ts) AS ts, count(*) AS count FROM (SELECT span_name, namespace, service, level, duration_ns, ts, CASE WHEN duration_ns > 0 THEN CAST(ceil(ln(duration_ns) / 0.020000666706669435) AS BIGINT) END AS bucket FROM logs WHERE customer_id = CAST(? AS BIGINT) AND ts >= CAST(? AS TIMESTAMP) AND ts <= CAST(? AS TIMESTAMP) AND namespace = ? AND service = ? AND span_name IS NOT NULL AND (duration_ns > 0 OR level = 'ERROR')) AS s GROUP BY span_name, namespace, service, bucket ORDER BY raw"
direct="SELECT json_object('name', span_name, 'namespace', namespace, 'service', service, 'bucket', bucket, 'count', count(*) FILTER (WHERE duration_ns > 0), 'errors', count(*) FILTER (WHERE level = 'ERROR'), 'levels', count(*) FILTER (WHERE level <> ''), 'total_ns', sum(duration_ns) FILTER (WHERE duration_ns > 0), 'min_ns', min(duration_ns) FILTER (WHERE duration_ns > 0), 'max_ns', max(duration_ns) FILTER (WHERE duration_ns > 0))::VARCHAR AS raw, min(ts) AS ts, count(*) AS count FROM (SELECT span_name, namespace, service, level, duration_ns, ts, CASE WHEN duration_ns > 0 THEN CAST(ceil(ln(duration_ns) / 0.020000666706669435) AS BIGINT) END AS bucket FROM logs WHERE customer_id = CAST(? AS BIGINT) AND ts >= CAST(? AS TIMESTAMP) AND ts <= CAST(? AS TIMESTAMP) AND namespace = ? AND service = ? AND span_name IS NOT NULL AND (duration_ns > 0 OR level = 'ERROR')) AS s GROUP BY span_name, namespace, service, bucket ORDER BY raw"
